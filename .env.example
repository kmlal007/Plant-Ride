# Copy to .env and fill in. Never commit .env or anything in ./secrets.

DB_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Shared secret the GPS gateway (Traccar) sends as X-Api-Key
TRACKING_API_KEY=
# Initial admin password (used only when the database is empty)
BOOTSTRAP_ADMIN_PASSWORD=

# Public URL(s) of the admin web, for CORS
CORS_ORIGINS=https://plantride.plant.local

# Push: fcm (default) | webhook | none
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
# Place the Firebase service account JSON in ./secrets/
FCM_CREDENTIALS_FILE=/run/secrets/plantride/fcm-service-account.json
# For PUSH_PROVIDER=webhook (in-house gateway)
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_AUTH=

# SMS (visitor OTPs): none | webhook
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH=

# Self-hosted map tiles for the admin map (plant layout may be confidential)
MAP_TILE_URL=

SEED_DEMO=false
